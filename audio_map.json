{
  "ar:أهلاً يا يونس! عامل إيه يا بطل؟ يلا نذاكر ونلعب سوا!": {
    "file": "audio/clips/ar1_001.mp3",
    "source": "ar1",
    "index": 1,
    "text": "أهلاً يا يونس! عامل إيه يا بطل؟ يلا نذاكر ونلعب سوا!"
  },
  "ar:يلا يا نوشّهْ، جاهز نبدأ المغامرة؟": {
    "file": "audio/clips/ar1_002.mp3",
    "source": "ar1",
    "index": 2,
    "text": "يلا يا نوشّهْ، جاهز نبدأ المغامرة؟"
  },
  "ar:برافو يا يونس!": {
    "file": "audio/clips/ar1_003.mp3",
    "source": "ar1",
    "index": 3,
    "text": "برافو يا يونس!"
  },
  "ar:شاطر يا نوشّهْ!": {
    "file": "audio/clips/ar1_004.mp3",
    "source": "ar1",
    "index": 4,
    "text": "شاطر يا نوشّهْ!"
  },
  "ar:الله ينور عليك يا بطل!": {
    "file": "audio/clips/ar1_005.mp3",
    "source": "ar1",
    "index": 5,
    "text": "الله ينور عليك يا بطل!"
  },
  "ar:إيه الحلاوة دي يا يونس!": {
    "file": "audio/clips/ar1_006.mp3",
    "source": "ar1",
    "index": 6,
    "text": "إيه الحلاوة دي يا يونس!"
  },
  "ar:عاش يا بطل! كمل كده!": {
    "file": "audio/clips/ar1_007.mp3",
    "source": "ar1",
    "index": 7,
    "text": "عاش يا بطل! كمل كده!"
  },
  "ar:مبروك يا نوشّهْ! كسبت نجمة جديدة!": {
    "file": "audio/clips/ar1_008.mp3",
    "source": "ar1",
    "index": 8,
    "text": "مبروك يا نوشّهْ! كسبت نجمة جديدة!"
  },
  "ar:يا سلام! تلات نجوم مرة واحدة!": {
    "file": "audio/clips/ar1_009.mp3",
    "source": "ar1",
    "index": 9,
    "text": "يا سلام! تلات نجوم مرة واحدة!"
  },
  "ar:برافو يا يونس! خلصت المستوى بنجاح!": {
    "file": "audio/clips/ar1_010.mp3",
    "source": "ar1",
    "index": 10,
    "text": "برافو يا يونس! خلصت المستوى بنجاح!"
  },
  "ar:يلا نفتح مستوى جديد!": {
    "file": "audio/clips/ar1_011.mp3",
    "source": "ar1",
    "index": 11,
    "text": "يلا نفتح مستوى جديد!"
  },
  "ar:ولا يهمك يا نوشّهْ، جرب تاني!": {
    "file": "audio/clips/ar1_012.mp3",
    "source": "ar1",
    "index": 12,
    "text": "ولا يهمك يا نوشّهْ، جرب تاني!"
  },
  "ar:فكر براحتك يا يونس، أنا مستنياك!": {
    "file": "audio/clips/ar1_013.mp3",
    "source": "ar1",
    "index": 13,
    "text": "فكر براحتك يا يونس، أنا مستنياك!"
  },
  "ar:قربت يا بطل! حاول مرة كمان!": {
    "file": "audio/clips/ar1_014.mp3",
    "source": "ar1",
    "index": 14,
    "text": "قربت يا بطل! حاول مرة كمان!"
  },
  "ar:تعالى نفكر فيها سوا يا نوشّهْ!": {
    "file": "audio/clips/ar1_015.mp3",
    "source": "ar1",
    "index": 15,
    "text": "تعالى نفكر فيها سوا يا نوشّهْ!"
  },
  "ar:شاطر يا يونس! أشوفك في مغامرة جديدة!": {
    "file": "audio/clips/ar1_016.mp3",
    "source": "ar1",
    "index": 16,
    "text": "شاطر يا يونس! أشوفك في مغامرة جديدة!"
  },
  "ar:اختار الإجابة الصح يا يونس!": {
    "file": "audio/clips/ar1_017.mp3",
    "source": "ar1",
    "index": 17,
    "text": "اختار الإجابة الصح يا يونس!"
  },
  "ar:اسمع كويس، وبعدين اختار!": {
    "file": "audio/clips/ar1_018.mp3",
    "source": "ar1",
    "index": 18,
    "text": "اسمع كويس، وبعدين اختار!"
  },
  "ar:دوس على الإجابة الصح!": {
    "file": "audio/clips/ar1_019.mp3",
    "source": "ar1",
    "index": 19,
    "text": "دوس على الإجابة الصح!"
  },
  "ar:وصل كل صورة بالحاجة اللي شبهها!": {
    "file": "audio/clips/ar1_020.mp3",
    "source": "ar1",
    "index": 20,
    "text": "وصل كل صورة بالحاجة اللي شبهها!"
  },
  "ar:امسك الصورة وحطها في مكانها الصح!": {
    "file": "audio/clips/ar1_021.mp3",
    "source": "ar1",
    "index": 21,
    "text": "امسك الصورة وحطها في مكانها الصح!"
  },
  "ar:يلا نعد مع بعض يا نوشّهْ!": {
    "file": "audio/clips/ar1_022.mp3",
    "source": "ar1",
    "index": 22,
    "text": "يلا نعد مع بعض يا نوشّهْ!"
  },
  "ar:تعالى نجمع الأرقام دي سوا!": {
    "file": "audio/clips/ar1_023.mp3",
    "source": "ar1",
    "index": 23,
    "text": "تعالى نجمع الأرقام دي سوا!"
  },
  "ar:يلا نشوف فاضل كام!": {
    "file": "audio/clips/ar1_024.mp3",
    "source": "ar1",
    "index": 24,
    "text": "يلا نشوف فاضل كام!"
  },
  "ar:دور على الحرف الصح يا يونس!": {
    "file": "audio/clips/ar1_025.mp3",
    "source": "ar1",
    "index": 25,
    "text": "دور على الحرف الصح يا يونس!"
  },
  "ar:رتب الحروف علشان نكوّن الكلمة!": {
    "file": "audio/clips/ar1_026.mp3",
    "source": "ar1",
    "index": 26,
    "text": "رتب الحروف علشان نكوّن الكلمة!"
  },
  "ar:يلا نتعلم إنجليزي يا بطل!": {
    "file": "audio/clips/ar1_027.mp3",
    "source": "ar1",
    "index": 27,
    "text": "يلا نتعلم إنجليزي يا بطل!"
  },
  "ar:بص كويس، واختار الشكل المطلوب!": {
    "file": "audio/clips/ar1_028.mp3",
    "source": "ar1",
    "index": 28,
    "text": "بص كويس، واختار الشكل المطلوب!"
  },
  "ar:اختار اللون الصح يا نوشّهْ!": {
    "file": "audio/clips/ar1_029.mp3",
    "source": "ar1",
    "index": 29,
    "text": "اختار اللون الصح يا نوشّهْ!"
  },
  "ar:افتكر مكان الصور، وحاول تلاقي كل صورتين شبه بعض!": {
    "file": "audio/clips/ar1_030.mp3",
    "source": "ar1",
    "index": 30,
    "text": "افتكر مكان الصور، وحاول تلاقي كل صورتين شبه بعض!"
  },
  "ar:بص على الترتيب، وقولي إيه اللي جاي بعد كده!": {
    "file": "audio/clips/ar1_031.mp3",
    "source": "ar1",
    "index": 31,
    "text": "بص على الترتيب، وقولي إيه اللي جاي بعد كده!"
  },
